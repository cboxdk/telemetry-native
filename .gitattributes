# Trim the distributed archive — but only things no build or CI job can need.
#
# export-ignore also applies to GitHub's source archives, and a job whose
# container has no git falls back to downloading one. Excluding /tests that way
# did not merely skip the tests in the musl jobs: `make test` found nothing to
# run and the job went green having tested nothing, which is worse than a red
# one. Tests, benchmarks and docs stay in the archive for that reason.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/llms.txt           export-ignore

# Keep line endings sane for the sources a build touches.
*.c     text eol=lf
*.h     text eol=lf
*.m4    text eol=lf
*.php   text eol=lf
*.phpt  text eol=lf
*.sh    text eol=lf
